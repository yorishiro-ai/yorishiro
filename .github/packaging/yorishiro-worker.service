# Override ExecStart in a systemd drop-in to serve official or tenant-specific worker targets.
# Use --worker=worker-target:official or --worker=worker-target:tenant:<tenant-id>.
[Unit]
Description=Yorishiro background worker
After=network.target yorishiro.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=yorishiro
Group=yorishiro
WorkingDirectory=/var/lib/yorishiro
Environment=LOCO_ENV=production
Environment=LOCO_CONFIG_FOLDER=/etc/yorishiro
ExecStart=/usr/bin/yorishiro start --worker=worker-target:shared
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yorishiro

[Install]
WantedBy=multi-user.target
