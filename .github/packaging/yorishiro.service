# Enable with `systemctl enable --now yorishiro`.
#
# The binary embeds production defaults unless the administrator supplies /etc/yorishiro/production.yaml.
# Package operations preserve administrator configuration.
[Unit]
Description=Yorishiro server
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=yorishiro
Group=yorishiro
WorkingDirectory=/var/lib/yorishiro
Environment=LOCO_ENV=production
Environment=LOCO_CONFIG_FOLDER=/etc/yorishiro
ExecStart=/usr/bin/yorishiro start
Restart=on-failure
RestartSec=5s

# The process needs no write access outside its own state directory, and no new privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yorishiro

[Install]
WantedBy=multi-user.target
