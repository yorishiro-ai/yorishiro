{
  "id": "game-dev-lore",
  "name": "game-dev-lore",
  "description": "A shared canon for game development setting materials, glossary terms, and assets.",
  "entity_types": {
    "character": {
      "description": "A character in the game world",
      "fields": {
        "name": {
          "type": "string",
          "description": "Character name",
          "maxLength": 100,
          "required": true,
          "x-embed": true
        },
        "game_id": {
          "type": "string",
          "description": "Identifier used in game data"
        },
        "role": {
          "type": "string",
          "description": "Character role",
          "enum": [
            "playable",
            "npc",
            "boss",
            "enemy",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "description": "Character description",
          "x-embed": true,
          "x-ui": {
            "widget": "textarea"
          }
        },
        "canon_status": {
          "type": "string",
          "description": "Approval state",
          "enum": [
            "draft",
            "proposed",
            "approved",
            "deprecated"
          ],
          "default": "draft"
        },
        "owner": {
          "type": "string",
          "description": "Person responsible for this item"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Labels for categorization",
          "uniqueItems": true
        }
      }
    },
