{
  "id": "worldbuilding",
  "name": "worldbuilding",
  "description": "Characters, locations, factions, and items for creative writing and TRPG worldbuilding",
  "entity_types": {
    "character": {
      "description": "A person or creature in the world",
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Full name or alias",
          "x-embed": true,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Appearance, personality, background",
          "x-embed": true,
          "x-ui": { "widget": "textarea" }
        },
        "traits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Personality traits, abilities, or notable features",
          "uniqueItems": true
        },
        "status": {
          "type": "string",
          "enum": ["alive", "deceased", "unknown"],
          "default": "alive",
          "description": "Current status in the story"
        },
        "profile": {
          "type": "object",
          "description": "Structured profile data",
          "properties": {
            "age": {
              "type": "integer",
              "minimum": 0,
              "description": "Age in years"
            },
            "gender": {
              "type": "string",
              "description": "Gender identity"
            },
            "occupation": {
              "type": "string",
              "description": "Role or profession"
            }
          }
        }
      }
    },
    "location": {
      "description": "A place in the world: city, dungeon, landmark, etc.",
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Name of the location",
          "x-embed": true,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "What the place looks like, its atmosphere, history",
          "x-embed": true,
          "x-ui": { "widget": "textarea" }
        },
        "type": {
          "type": "string",
          "enum": ["city", "village", "dungeon", "wilderness", "landmark", "building", "other"],
          "description": "Category of location"
        }
      }
    },
    "faction": {
      "description": "An organization, group, or political entity",
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Name of the faction",
          "x-embed": true,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Goals, beliefs, structure",
          "x-embed": true,
          "x-ui": { "widget": "textarea" }
        },
        "alignment": {
          "type": "string",
          "description": "Moral alignment or disposition"
        }
      }
    },
    "item": {
      "description": "A notable object: weapon, artifact, document, etc.",
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Name of the item",
          "x-embed": true,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "What it is, what it does, its history",
          "x-embed": true,
          "x-ui": { "widget": "textarea" }
        },
        "type": {
          "type": "string",
          "enum": ["weapon", "armor", "artifact", "document", "consumable", "other"],
          "description": "Category of item"
        },
        "properties": {
          "type": "object",
          "description": "Game-mechanical properties (damage, weight, etc.)",
          "properties": {
            "weight": { "type": "number", "minimum": 0, "description": "Weight in arbitrary units" },
            "value": { "type": "integer", "minimum": 0, "description": "Monetary value" },
            "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "legendary"], "description": "Rarity tier" }
          }
        }
      }
    }
  },
  "relation_types": {
    "knows": {
      "source": "character",
      "target": "character",
      "description": "These characters know each other"
    },
    "member_of": {
      "source": "character",
      "target": "faction",
      "description": "Character belongs to this faction"
    },
    "located_in": {
      "source": "character",
      "target": "location",
      "description": "Character is currently at this location"
    },
    "controls": {
      "source": "faction",
      "target": "location",
      "description": "Faction controls or occupies this location"
    },
    "possesses": {
      "source": "character",
      "target": "item",
      "description": "Character owns or carries this item"
    },
    "found_at": {
      "source": "item",
      "target": "location",
      "description": "Item can be found at this location"
    }
  }
}
