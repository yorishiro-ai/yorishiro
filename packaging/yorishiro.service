# Installed by both the `yorishiro-ee` and `yorishiro-ce` packages, under one name.
# Enable with `systemctl enable --now yorishiro`.
#
# One unit for both editions. The packages conflict, so a machine has exactly one of them, and
# a single name makes switching editions an in-place swap of the file: whatever was enabled
# stays enabled, and no `enable` symlink is left pointing at a unit that is not there.
#
# Configuration goes in /etc/yorishiro/config.yml; at minimum `database_url`.
# /etc/yorishiro/config.example.yml lists every setting with its default.
[Unit]
Description=Yorishiro server
After=network.target

[Service]
Type=simple
User=yorishiro
Group=yorishiro
WorkingDirectory=/var/lib/yorishiro
# The whole configuration, in one file. Without this the server would look for `config.yml` in
# WorkingDirectory, which is the state directory -- not somewhere an operator would think to
# put configuration. Both editions read the same /etc/yorishiro/, and they conflict, so a
# machine has one of them and one configuration directory.
Environment=YORISHIRO_CONFIG_PATH=/etc/yorishiro/config.yml
# Each package installs its own binary at this path, so the unit does not name an edition.
ExecStart=/usr/bin/yorishiro-server
Restart=on-failure
# 78 is EX_CONFIG, which the binary uses for "configuration is absent or unusable" and nothing
# else. Without this, an operator who runs `enable --now` before setting DATABASE_URL gets a
# five-second crashloop that never ends, and `systemctl is-failed` answers `activating` rather
# than `failed` -- so monitoring that watches unit state never sees it. Every other failure
# still retries, which is what a database that has not finished starting needs.
RestartPreventExitStatus=78
RestartSec=5s

# The process needs no write access outside its own state directory, and no new privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yorishiro

[Install]
WantedBy=multi-user.target
