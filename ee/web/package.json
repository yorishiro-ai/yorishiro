{
  "name": "yorishiro-hosted-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build && touch dist/.gitkeep",
    "preview": "rsbuild preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.5",
    "@xyflow/react": "^12.8.2",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
