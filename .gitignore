/target
*.swp
*.swo
.env
.env.local
# config/sqlite.yaml's own default filenames (DATABASE_URL, QUEUE_URL) land in the repo root when
# `cargo loco start -e sqlite` runs from here; never meant to be committed.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
.cargo-cache
.worktrees/
/models
# `ee/web/` carries its own .gitignore for `dist/` and `node_modules/`, including the
# `!dist/.gitkeep` exception the embed needs.

# Loco rebuild reference: the pre-rebuild tree, kept locally for porting. Never committed:
# old/ee/** sits outside ee/, so committing it would relicense paid code as BUSL.
/old
debug/

# ts-rs writes here from `#[ts(export, export_to = "../frontend/src/bindings/")]` in
# src/dtos/, regenerated by `cargo test --lib` every run.
/frontend
